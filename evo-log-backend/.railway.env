# Railway Environment Variables for EVO-LOG Backend

# Application
APP_NAME=EVO-LOG EM-ERP
APP_VERSION=2.0.0
DEBUG=False

# Database - Railway PostgreSQL
DATABASE_URL=${{POSTGRES_URL}}
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis - Railway Redis
REDIS_URL=${{REDIS_URL}}

# Security
SECRET_KEY=${{SECRET_KEY}}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["https://your-frontend.vercel.app","https://evo-log.vercel.app"]

# MinIO (optional)
MINIO_ENABLED=True
MINIO_ENDPOINT=${{MINIO_ENDPOINT}}
MINIO_ACCESS_KEY=${{MINIO_ACCESS_KEY}}
MINIO_SECRET_KEY=${{MINIO_SECRET_KEY}}
MINIO_SECURE=True
MINIO_BUCKET_DOCUMENTS=documents

# Sentry (optional)
SENTRY_DSN=${{SENTRY_DSN}}

# Email (optional)
SMTP_HOST=${{SMTP_HOST}}
SMTP_PORT=${{SMTP_PORT}}
SMTP_USER=${{SMTP_USER}}
SMTP_PASSWORD=${{SMTP_PASSWORD}}
SMTP_FROM=noreply@evo-log.cm

# Celery
CELERY_BROKER_URL=${{REDIS_URL}}
CELERY_RESULT_BACKEND=${{REDIS_URL}}
