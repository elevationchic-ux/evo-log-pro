# EVO-LOG SaaS Production Configuration

# Application
APP_NAME=EVO-LOG SaaS
APP_VERSION=2.0.0
DEBUG=False

# Database (PostgreSQL Production)
DATABASE_URL=postgresql://evo_user:strong_password_change_me@localhost:5432/evo_log_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis (Cache & Pub/Sub)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=300

# Security
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Production domains)
BACKEND_CORS_ORIGINS=https://evo-log.cm,https://www.evo-log.cm

# MinIO (S3-compatible storage)
MINIO_ENABLED=True
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=True
MINIO_BUCKET_DOCUMENTS=evo-documents

# Sentry (Error tracking)
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID

# Email (SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@evo-log.cm
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@evo-log.cm

# WhatsApp (Optional)
WHATSAPP_ENABLED=False
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Celery (Background tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
